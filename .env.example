# App / AI Studio (existing)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# ─── Firebase Firestore (cross-machine blog & case study sync) ───────────────
# Create a free project at https://console.firebase.google.com
# Enable Firestore → Start in test mode → copy config below
VITE_FIREBASE_API_KEY="your-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
VITE_FIREBASE_APP_ID="your-app-id"
# Without these vars the app falls back to localStorage (single-machine only)

# --- Admin email OTP auth (Vercel serverless + your SMTP) ---
# Long random string used to sign challenge + session cookies (min 16 chars)
AUTH_SECRET="change-me-to-a-long-random-secret"

# Comma-separated allowlist of admin emails (required)
ADMIN_EMAILS="you@yourdomain.com"

# SMTP (your own mail server / Google Workspace / Microsoft 365 / etc.)
SMTP_HOST="smtp.yourdomain.com"
SMTP_PORT="587"
SMTP_USER="you@yourdomain.com"
SMTP_PASS="your-smtp-password-or-app-password"
SMTP_FROM="you@yourdomain.com"

# Optional: when using `npm run dev` + `vercel dev` together
# VERCEL_DEV_URL="http://127.0.0.1:3001"
