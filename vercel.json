{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/blogs",
      "destination": "/blog",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/admin(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    },
    {
      "source": "/spa-shell(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/admin(.*)",
      "destination": "/spa-shell.html"
    }
  ],
  "functions": {
    "api/auth/*.js": {
      "includeFiles": "api/**"
    },
    "api/blogs.js": {
      "maxDuration": 10
    },
    "api/case-studies.js": {
      "maxDuration": 10
    }
  }
}
